# ==========================================
# AcademiaX Microservices Configuration
# Environment Variables & Secrets Template
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_DB=academiax_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
DB_URL=jdbc:postgresql://postgres:5432/academiax_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here

# JWT Authentication
# Must be at least 32 characters (256 bits) for HMAC-SHA256
JWT_SECRET=YourSuperSecretKeyForJWTSigningMustBeLongEnough2026!
JWT_EXPIRATION_MS=604800000

# Service Discovery (Eureka)
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
