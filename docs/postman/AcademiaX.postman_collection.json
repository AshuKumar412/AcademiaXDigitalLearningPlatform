    {
      "name": "02. Authentication Service",
      "item": [
        {
          "name": "Register Student (No JWT Returned)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration succeeds with 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Success flag is true', function () { pm.expect(data.success).to.be.true; });",
                  "pm.test('CRITICAL: NO JWT returned during registration', function () {",
                  "    pm.expect(data.token).to.be.undefined;",
                  "    pm.expect(data.accessToken).to.be.undefined;",
                  "});",
                  "if (data.userId) { pm.environment.set('studentId', data.userId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student_test_{{$randomInt}}\",\n  \"email\": \"student_{{$randomInt}}@academia.edu\",\n  \"password\": \"SecurePass2026\",\n  \"role\": \"STUDENT\"\n}"
            },
