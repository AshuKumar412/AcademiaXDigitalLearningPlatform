        {
          "name": "Demo 1: Trigger Payment Failure Scenario (Auto Seat Release)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Enrollment reports failure or conflict (409/500)', function () {",
                  "    pm.expect([409, 500]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"courseId\": {{courseId}},\n  \"testScenario\": \"FAIL\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enrollments",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments"]
            },
            "description": "Simulates payment gateway rejection. Course seat is temporarily reserved then automatically released by Saga orchestrator. Check courses.enrolled_count in PostgreSQL."
          },
          "response": []
        },
        {
          "name": "Demo 2: Trigger Payment Timeout Scenario (Retained Pending)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gateway timeout returns 500/503 holding state in PENDING_PAYMENT', function () {",
                  "    pm.expect([500, 503]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"courseId\": {{courseId}},\n  \"testScenario\": \"TIMEOUT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enrollments",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments"]
            },
            "description": "Simulates network timeout. Enrollment is held in PENDING_PAYMENT with seat reserved until background reconciliation or manual reconcile endpoint."
          },
          "response": []
        }
      ]
