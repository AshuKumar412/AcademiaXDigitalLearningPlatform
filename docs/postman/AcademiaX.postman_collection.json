                  "var data = pm.response.json();",
                  "pm.test('Returns signed accessToken', function () {",
                  "    pm.expect(data.accessToken).to.be.a('string');",
                  "    pm.expect(data.tokenType).to.eql('Bearer');",
                  "});",
                  "if (data.accessToken) {",
